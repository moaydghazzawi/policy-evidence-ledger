{
  "name": "policy-evidence-ledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:api": ".venv/bin/policy-evidence-ledger serve --port 8000",
    "dev:full": "concurrently -k -n interface,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "serve": ".venv/bin/policy-evidence-ledger serve --port 8000",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "lint:python": ".venv/bin/ruff check .",
    "audit:tracked": ".venv/bin/python scripts/audit_tracked_files.py",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies:all": "npm audit --audit-level=high",
    "test:python": ".venv/bin/pytest",
    "test:ui": "playwright test",
    "screenshots": "playwright test --config playwright.capture.config.ts",
    "test": "npm run typecheck && npm run lint && npm run lint:python && npm run format:check && npm run audit:tracked && npm run test:python && npm run test:ui"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "concurrently": "^10.0.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "type": "module"
}
